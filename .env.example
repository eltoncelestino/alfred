# ============================================================================
# ALFRED — VARIÁVEIS DE AMBIENTE (EXEMPLO)
# Copie este arquivo para ".env.local" e preencha com suas credenciais locais.
# NUNCA versione o arquivo ".env.local" no Git.
# ============================================================================

# Chave de API do Google Gemini (Google AI Studio)
EXPO_PUBLIC_GEMINI_KEY=INSIRA_SUA_CHAVE_GEMINI_AQUI

# E-mail padrão pré-preenchido no modal de vinculação (opcional)
EXPO_PUBLIC_DEFAULT_USER_EMAIL=seu.email@gmail.com

# Hostname / IPv4 da máquina na rede Wi-Fi local para o Expo Go (opcional, detectado automaticamente)
# Exemplo: EXPO_PUBLIC_PACKAGER_HOSTNAME=192.168.1.100
REACT_NATIVE_PACKAGER_HOSTNAME=
EXPO_PUBLIC_PACKAGER_HOSTNAME=
EXPO_PUBLIC_USE_RN_FETCH=1
